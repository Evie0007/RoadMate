 157A Final Project: RoadMate EER Diagram&lt;/b&gt;&lt;br&gt;Team: Evie Ho, Mari Yamaguchi, Keyi Tan, Angel Cruz, Quang Lam Trinh" style="text;html=1;align=right;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="EER1"><mxGeometry x="1388" y="32" width="518" height="50" as="geometry"/></mxCell><mxCell id="EERn86" value="Relationship Degree:&lt;br&gt;• All relationship sets are binary&lt;br&gt;&lt;br&gt;Constraints:&lt;br&gt;• A Vehicle cannot be in two Reservations with&lt;br&gt;   overlapping rental periods&lt;br&gt;• ReturnDate must be after PickupDate&lt;br&gt;• A Discount can only be applied before its EndDate&lt;br&gt;• TotalCost is derived from rental days × DailyRate,&lt;br&gt;   minus any Discount&lt;br&gt;• UserAccount specialization (on Role) is&lt;br&gt;   disjoint and total" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="EER1"><mxGeometry x="183" y="933" width="346" height="274" as="geometry"/></mxCell><mxCell id="EERe0" value="" style="endArrow=none;html=1;fontStyle=1;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="EER1" source="EERn0" target="EERn1"><mxGeometry x="0" relative="1" as="geometry"/></mxCell><mxCell id="EERe1" value="" style="endArrow=none;html=1;fontStyle=1;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="EER1" source="EERn0" target="EERn2"><mxGeometry x="0" relative="1" as="geometry"/></mxCell><mxCell id="EERe2" value="" style="endArrow=none;html=1;fontStyle=1;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="EER1" source="EERn0" target="EERn3"><mxGeometry x="0" relative="1" as="geometry"/></mxCell><mxCell id="EERe3" value="" style="endArrow=none;html=1;fontStyle=1;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="EER1" source="EERn0" target="EERn4"><mxGeometry x="0" relative="1" as="geometry"/></mxCell><mxCell id="EERe4" value="" style="endArrow=none;html=1;fontStyle=1;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="EE